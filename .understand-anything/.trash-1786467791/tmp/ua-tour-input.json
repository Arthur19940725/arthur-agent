{
  "nodes": [
    {
      "id": "file:agent/llm.py",
      "name": "llm.py",
      "filePath": "agent/llm.py",
      "summary": "加载项目环境变量并初始化供各智能体共享的 LangChain 聊天模型，模型名由 LLM_QWEN_MAX 配置。",
      "type": "file"
    },
    {
      "id": "file:agent/main_agent.py",
      "name": "main_agent.py",
      "filePath": "agent/main_agent.py",
      "summary": "组装主 Deep Agent、三个专业子智能体及文件处理工具，并负责按会话异步流式执行任务。执行过程中建立隔离目录与上下文，转发子智能体活动、最终答案和错误事件。",
      "type": "file"
    },
    {
      "id": "file:agent/prompts.py",
      "name": "prompts.py",
      "filePath": "agent/prompts.py",
      "summary": "安全读取项目的 YAML 提示词配置，并在模块加载时拆分出主智能体和子智能体配置供组装模块使用。",
      "type": "file"
    },
    {
      "id": "file:agent/subagents/database_query_agent.py",
      "name": "database_query_agent.py",
      "filePath": "agent/subagents/database_query_agent.py",
      "summary": "从提示词配置构造数据库查询子智能体定义，并为其注册表发现、表数据预览和自定义 SQL 查询工具。",
      "type": "file"
    },
    {
      "id": "file:agent/subagents/network_search_agent.py",
      "name": "network_search_agent.py",
      "filePath": "agent/subagents/network_search_agent.py",
      "summary": "从提示词配置构造网络搜索子智能体定义，并将 Tavily 搜索函数注册为其唯一工具。",
      "type": "file"
    },
    {
      "id": "file:api/server.py",
      "name": "server.py",
      "filePath": "api/server.py",
      "summary": "提供 FastAPI 服务入口，涵盖后台启动智能体任务、上传与安全浏览输出文件、下载文件以及按 thread_id 隔离的 WebSocket 实时通信。服务启动时还会把当前事件循环绑定到连接管理器。",
      "type": "file"
    },
    {
      "id": "file:tools/db_tools.py",
      "name": "db_tools.py",
      "filePath": "tools/db_tools.py",
      "summary": "实现供数据库子智能体调用的 MySQL 工具：读取并校验连接配置、列出数据表、预览单表数据以及执行自定义查询。查询结果统一转成 CSV 风格文本，并通过监控层上报工具调用。",
      "type": "file"
    },
    {
      "id": "file:tools/tavily_tool.py",
      "name": "tavily_tool.py",
      "filePath": "tools/tavily_tool.py",
      "summary": "从环境变量初始化 Tavily 客户端，并暴露带主题、结果数量和原始内容开关的 LangChain 网络搜索工具。每次搜索前都会向监控层报告调用参数。",
      "type": "file"
    },
    {
      "id": "file:api/context.py",
      "name": "context.py",
      "filePath": "api/context.py",
      "summary": "使用 ContextVar 隔离每个异步请求的会话目录与 thread ID，并提供设置、读取和重置上下文的辅助函数。",
      "type": "file"
    },
    {
      "id": "file:api/monitor.py",
      "name": "monitor.py",
      "filePath": "api/monitor.py",
      "summary": "集中管理工具与智能体执行事件，将监控消息按 thread ID 推送到 FastAPI WebSocket、脚本流输出和控制台。还维护 thread ID 到活动 WebSocket 的连接映射。",
      "type": "file"
    },
    {
      "id": "file:tools/markdown_tools.py",
      "name": "markdown_tools.py",
      "filePath": "tools/markdown_tools.py",
      "summary": "提供 LangChain Markdown 生成工具，在会话目录约束下解析输出路径、创建父目录并以 UTF-8 写入文档，同时上报执行状态。",
      "type": "file"
    },
    {
      "id": "file:tools/pdf_tools.py",
      "name": "pdf_tools.py",
      "filePath": "tools/pdf_tools.py",
      "summary": "提供 Markdown 转 PDF 的 LangChain 工具，负责会话内路径解析、源文件校验与输出路径选择，再委托 Word COM 转换器执行实际转换。",
      "type": "file"
    },
    {
      "id": "file:tools/upload_file_read_tool.py",
      "name": "upload_file_read_tool.py",
      "filePath": "tools/upload_file_read_tool.py",
      "summary": "提供会话隔离的上传文件读取工具，按扩展名处理文本、Word、PDF 与 Excel，并对可选依赖缺失和读取失败返回明确错误。",
      "type": "file"
    },
    {
      "id": "file:utils/path_utils.py",
      "name": "path_utils.py",
      "filePath": "utils/path_utils.py",
      "summary": "统一清洗虚拟路径前缀，并结合会话目录解析 Windows、Unix 风格及上传目录路径，避免重复嵌套会话目录。",
      "type": "file"
    },
    {
      "id": "file:utils/word_converter.py",
      "name": "word_converter.py",
      "filePath": "utils/word_converter.py",
      "summary": "通过 Markdown 转临时 HTML、再调用 Microsoft Word COM 导出 PDF，并在 finally 中关闭 Word、删除临时文件和释放 COM。",
      "type": "file"
    },
    {
      "id": "file:agent/subagents/knowledge_base_agent.py",
      "name": "knowledge_base_agent.py",
      "filePath": "agent/subagents/knowledge_base_agent.py",
      "summary": "根据 YAML 提示词配置组装知识库子智能体描述，并注册 RAGFlow 助手发现与问答工具，供主智能体协作调用。",
      "type": "file"
    },
    {
      "id": "file:rawflow/chat_assistant_demo.py",
