# ===========================================
# arthur-agent - 环境变量配置模板
# 复制此文件为 .env 并填入你的真实配置
# ===========================================

# ---------- RAGFlow 知识库服务 ----------
RAGFLOW_API_URL=http://your-ragflow-server-ip
RAGFLOW_API_KEY=your-ragflow-api-key

# ---------- LLM 大模型配置 ----------
# DeepSeek 官方 OpenAI 兼容接口
# Flash：子智能体（搜索/数据库/RAG）
# Pro：主控路由与综合，开启 thinking=high
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
LLM_DEEPSEEK_MODEL=deepseek-v4-flash
LLM_DEEPSEEK_PRO=deepseek-v4-pro

# ---------- JWT 登录认证 ----------
# 生成密码哈希：python -c "from pwdlib import PasswordHash; print(PasswordHash.recommended().hash('替换为登录密码'))"
AUTH_USERNAME=arthur
AUTH_USER_ID=arthur
AUTH_PASSWORD_HASH=<argon2id-password-hash>
# 至少 32 字节随机值；可用：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=15
AUTH_JWT_ISSUER=arthur-agent
AUTH_JWT_AUDIENCE=arthur-agent-api
AUTH_WS_AUTH_TIMEOUT_SECONDS=5
# 跨域前端可填逗号分隔的 origin；同源部署留空
AUTH_CORS_ORIGINS=

# ---------- 对话历史持久化 ----------
# 可选；相对路径以项目根目录为基准。默认值：data/checkpoints.sqlite
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# ---------- Agent 任务资源边界 ----------
DEEP_SEARCH_MAX_QUERY_BYTES=32768
DEEP_SEARCH_MAX_ACTIVE_PER_USER=2
DEEP_SEARCH_MAX_ACTIVE_PROCESS=8
DEEP_SEARCH_RATE_LIMIT=10
DEEP_SEARCH_RATE_WINDOW_SECONDS=60
DEEP_SEARCH_RATE_HISTORY_TTL_SECONDS=3600
DEEP_SEARCH_EVENT_HISTORY_MAX_EVENTS=100
DEEP_SEARCH_EVENT_HISTORY_MAX_BYTES=262144
DEEP_SEARCH_EVENT_HISTORY_TTL_SECONDS=3600

# ---------- Tavily 网络搜索 ----------
# 注册地址: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key

# ---------- MySQL 数据库 ----------
MYSQL_USER=your-db-user
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=your-database-name
MYSQL_HOST=localhost
MYSQL_PORT=3306
